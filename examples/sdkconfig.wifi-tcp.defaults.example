# ESPView Wi-Fi + TCP 传输示例配置片段（全部占位符 / 通用值，无真实凭据）。
#
# 用法（详见 examples/quickstart.md 第 5 步）：
#   1. 复制为 esp32/sdkconfig.defaults.wifi-tcp
#      （该文件名匹配 .gitignore 的 esp32/sdkconfig.* 规则，不会误提交）；
#   2. 把 REPLACE_WITH_* 占位符替换为本地值；
#   3. 与仓库 sdkconfig.defaults 叠加构建：
#      idf.py -B build\wifi-tcp -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.wifi-tcp" build
#
# 说明：正式 UART baseline 为 115200（见 sdkconfig.defaults）；本片段把传输
# 切换为 Wi-Fi STA + TCP（PC 侧 TCP server，默认端口 8765）。

# 协议传输：Wi-Fi STA + TCP
CONFIG_ESPVIEW_TRANSPORT_TCP=y

# Wi-Fi 凭据（占位符！真实值只写入本地未跟踪 sdkconfig，绝不提交到 git）
CONFIG_ESPVIEW_WIFI_SSID="REPLACE_WITH_YOUR_SSID"
CONFIG_ESPVIEW_WIFI_PASSWORD="REPLACE_WITH_YOUR_PASSWORD"

# PC TCP server IPv4（占位：与 Kconfig 默认值一致）
CONFIG_ESPVIEW_TCP_SERVER_IP="192.168.1.100"
CONFIG_ESPVIEW_TCP_SERVER_PORT=8765

# 生产默认：测试钩子关闭；Wi-Fi 扫描期间挂起 OLED 刷新
CONFIG_ESPVIEW_TEST_TRANSPORT_SWITCH=n
CONFIG_ESPVIEW_SCAN_SUSPEND_OLED=y

# 可选：启用 OLED 诊断/物理显示（128x64 SSD1306，I2C 0x3C，SDA=GPIO21 SCL=GPIO22）
# CONFIG_ESPVIEW_OLED_ENABLE=y
