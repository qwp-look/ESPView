menu "OLED Display (Diagnostics + Physical Sink)"

config ESPVIEW_OLED_ENABLE
    bool "Enable OLED display (M7-A diagnostics + M7-C2 physical sink)"
    default n
    help
        M7-A：独立的 OLED 状态显示（128x64 SSD1306/SH1106，I2C）。
        低优先级任务（默认 2，低于 session=5 / stats=3）周期渲染
        StatusSnapshot（main 注入）并上传 framebuffer。
        M7-C2：启用时同时注册 PhysicalDisplaySink（IDisplaySink，经
        DisplayRouter 收 LVGL 应用帧，PhysicalRenderer 渲染进共享 1KB
        应用 fb 由任务上传）；taskLoop 按场景分发（Application=dirty
        触发应用帧；Diagnostics=renderStatus 诊断页）。OLED 任务绝不
        触碰 protocol sendMutex / Transport；I2C 上传只发生在 OLED 任务内。
        禁用时零代码路径：PhysicalDisplaySink 不编译、main 不注册
        （OLED=n 双构建无未定义引用；DisplayRouter 无 physical sink 时
        setMode 需要 physical 的模式返回 kInvalidParam）。

config ESPVIEW_OLED_SDA_GPIO
    int "OLED I2C SDA GPIO number"
    default 13 if IDF_TARGET_ESP32S3
    default 21
    range 0 48
    help
        M8-A7：range 覆盖经典 ESP32（0..39）与 ESP32-S3（0..48）；
        初始化期按 target 校验（target_info 组件）。
        M8-C C7：默认按 target 条件化 —— 经典 ESP32 21 / ESP32-S3 13
        （YD-ESP32-23 2022-V1.3 实测接线：SDA→GPIO13，SSD1306 0x3C
        探测成功 err=0 ok=1；sdkconfig 显式值仍可覆盖）。

config ESPVIEW_OLED_SCL_GPIO
    int "OLED I2C SCL GPIO number"
    default 18 if IDF_TARGET_ESP32S3
    default 22
    range 0 48
    help
        M8-A7：同上；range 覆盖双 target。
        M8-C C7：默认按 target 条件化 —— 经典 ESP32 22 / ESP32-S3 18
        （YD-ESP32-23 2022-V1.3 实测接线：SCL→GPIO18；sdkconfig 显式值仍可覆盖）。

config ESPVIEW_OLED_I2C_CLK_HZ
    int "OLED I2C clock frequency (Hz)"
    default 400000
    range 100000 1000000

config ESPVIEW_OLED_ADDR_AUTO
    bool "Auto-detect OLED I2C address (probe 0x08..0x77)"
    default y
    help
        M7-A：启动时用 i2c_master_probe 扫描 0x08..0x77，优先
        0x3C/0x3D，否则取首个响应地址。扫描无响应则按 refresh
        周期重试（有界 re-init，带退避）。

config ESPVIEW_OLED_ADDR
    int "OLED I2C address (7-bit raw; used when auto is off)"
    default 0x3C
    range 0x08 0x77
    depends on !ESPVIEW_OLED_ADDR_AUTO

choice ESPVIEW_OLED_CONTROLLER
    prompt "OLED controller type"
    default ESPVIEW_OLED_CONTROLLER_AUTO
    help
        M7-A：AUTO = 探测地址后默认 SSD1306（无回读，无法可靠区分
        控制器型号）；SSD1306/SH1106 强制指定（如 132x64 GDDRAM
        变体）。命令序列差异见 shared/oled/oled_cmd.cpp。

config ESPVIEW_OLED_CONTROLLER_AUTO
    bool "Auto (default SSD1306)"

config ESPVIEW_OLED_CONTROLLER_SSD1306
    bool "SSD1306 (128x64)"

config ESPVIEW_OLED_CONTROLLER_SH1106
    bool "SH1106 (132x64 GDDRAM, column offset 2)"

endchoice

config ESPVIEW_OLED_REFRESH_MS
    int "OLED refresh period (ms)"
    default 500
    range 100 60000

config ESPVIEW_OLED_TASK_STACK
    int "OLED task stack size (bytes)"
    default 4096
    range 2048 16384

config ESPVIEW_OLED_TASK_PRIORITY
    int "OLED task priority (must stay below session=5 / stats=3)"
    default 2
    range 1 2

config ESPVIEW_OLED_I2C_TIMEOUT_MS
    int "OLED I2C transaction timeout (ms)"
    default 50
    range 5 1000

config ESPVIEW_OLED_MAX_REINIT
    int "Consecutive I2C errors before bus reset/re-init"
    default 3
    range 1 100
    help
        M7-A 错误恢复：连续失败达该阈值触发一次 bus reset / 重建
        （带指数退避）；每个故障窗口重初始化轮数有界（kMaxReinitCycles），
        冷却期后才会再次尝试 —— 不允许无限重置循环。错误计数只增不减。

endmenu


menu "Physical Rendering Pipeline"
    choice ESPVIEW_RENDER_PIPELINE
        prompt "Physical rendering pipeline quality (M8-C C4)"
        default ESPVIEW_RENDER_PIPELINE_FAST
        help
            M8-C C1/C4: RGB565 -> Mono1 physical rendering pipeline
            algorithm composition (shared/render pipeline factory).
            fast    = FastScaleThresholdStage (2/5 nearest-neighbor +
                      center crop + threshold pass-through; classic
                      ESP32 low CPU / low RAM).
            quality = Luminance + bilinear scale + center crop + 4x4
                      Bayer ordered dither (ESP32-S3, optional PSRAM).
            Selection is profile-driven (scripts/espview_profiles.py
            render attribute) and takes effect at pipeline construction
            time; no runtime hot-switch.

        config ESPVIEW_RENDER_PIPELINE_FAST
            bool "Fast (classic ESP32 baseline)"

        config ESPVIEW_RENDER_PIPELINE_QUALITY
            bool "Quality (ESP32-S3 / PSRAM)"
    endchoice
endmenu
