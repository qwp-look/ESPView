# ESPView repository ignore rules

# Build outputs
build/
esp32/build/
esp32/build_debug/
pc/build*/
shared/*/build*/

# CI-generated local dirs (docs-security check logs / release artifacts)
check-logs/
release/

# ESP-IDF managed components (regenerated by `idf.py reconfigure` via component manager)
esp32/managed_components/

# ESP-IDF generated config (machine-specific: UART pins/baud + LOCAL Wi-Fi credentials).
# NEVER commit any of these: esp32/sdkconfig* may contain CONFIG_ESPVIEW_WIFI_SSID/PASSWORD.
esp32/sdkconfig
esp32/sdkconfig.*
!esp32/sdkconfig.defaults
!esp32/sdkconfig.defaults.esp32
!esp32/sdkconfig.defaults.esp32s3

# Python bytecode
__pycache__/
*.pyc

# Editor/tool temp files
*.swp
*.tmp
*~
*.log
*.bak
*.orig
*.rej

# Private key / secret material (defense-in-depth)
*.pem
*.key
*.p12
*.pfx
*.crt
*.der
*.env
